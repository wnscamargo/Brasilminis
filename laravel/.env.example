APP_NAME="Brasil Minis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Uploads SEM symlink (Locaweb bloqueia symlink()). Disco 'uploads' grava direto numa
# pasta pública. Em produção aponte para o public_html real da hospedagem:
# UPLOADS_ROOT=/home/storage/d/6c/81/brasilminis1/public_html/uploads
# UPLOADS_URL=https://seudominio.com.br/uploads
UPLOADS_ROOT=
UPLOADS_URL=/uploads

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@brasilminis.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Pagamento (preparado para Mercado Pago - ainda simulado)
PAYMENT_DRIVER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Frete
FREE_SHIPPING_THRESHOLD=300
STANDARD_SHIPPING=29.90

# Admin seed
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@brasilminis.com"
ADMIN_PASSWORD="Admin@2025"

VITE_APP_NAME="${APP_NAME}"
